 void DebugConsole_Init(void) {
+    // Megaton Hammer playtest auto-boot (runs once when a playtest mod O2R is mounted).
+    GameInteractor::Instance->RegisterGameHook<GameInteractor::OnZTitleUpdate>(MhPlaytestBootHook);
+    GameInteractor::Instance->RegisterGameHook<GameInteractor::OnGameFrameUpdate>(MhPlaytestRenderProbe);
+    GameInteractor::Instance->RegisterGameHook<GameInteractor::OnGameFrameUpdate>(MhDialogueInterpreter);
