+                // getItemId == getItemEntry.getItemId) falls back to ItemTable_Retrieve(placeholder) and opens a
+                // bogus textId -> Message_OpenText memcpy crash (0xC0000005).
+                mhPlayer->getItemId = entry.getItemId;
+            }
+        }
+    });
