+// Megaton Hammer: append a line to a boot log next to the executable, so the editor can verify
+// the auto-boot/warp ran (and how far it got) headlessly, without watching the screen.
+static void MhBootLog(const std::string& msg) {
+    std::ofstream f("mh_playtest_boot.log", std::ios::app);
+    if (f) {
+        f << msg << std::endl;
+    }
+}
+
+// Megaton Hammer: apply a custom starting inventory (from the editor's inventory editor) onto a
+// fresh save. The payload is the "inv" object of mh/info: { hearts, tiers{...}, toggles[...] }.
+// Tiers grant everything up to the chosen level. Keys match Editor/InventoryCatalog (OoT).
+// #5: SoH stores zTargetSetting as a GLOBAL (cross-file) setting that SaveManager re-applies during the
+// file load that runs after our boot hook, clobbering the editor's choice. Remember it here and re-assert
+// it for the first ~90 frames in the scene (render probe). -1 = no custom value (debug/empty → leave as-is).
+static int sMhZTarget = -1;
+
+// #7: the editor's player name is encoded to the OoT filename charset and written at boot, but SoH's
+// SaveManager loads the save AFTER the boot hook and overwrites gSaveContext.playerName (a per-save field)
+// with the stored file's name — so the in-game name (e.g. in a textbox's MESSAGE_NAME) showed jumbled.
+// Stash the encoded bytes here and re-assert them for the first frames in-scene, exactly like sMhZTarget.
+static u8 sMhPlayerName[8];
+static bool sMhNameSet = false;
+// The actual scene number the playtest level loads into: SCENE_MH_APPEND in append mode, or the replaced
+// scene's own id in replace mode. The render probe keys its per-frame re-asserts (name, Z-target) off this
+// — keying off SCENE_MH_APPEND alone skipped them entirely in replace mode, so the player name showed the
+// stored/garbage save name instead of the injected one.
+static s32 sMhPlaytestScene = -1;
+
+static void MhApplyCustomInventory(const nlohmann::json& inv) {
+    int hearts = inv.value("hearts", 3);
+    gSaveContext.healthCapacity = (s16)(hearts * 16);
+    gSaveContext.health = gSaveContext.healthCapacity;
+
+    auto hasToggle = [&](const char* k) -> bool {
+        if (!inv.contains("toggles") || !inv["toggles"].is_array()) return false;
+        for (auto& t : inv["toggles"]) if (t.is_string() && t.get<std::string>() == k) return true;
+        return false;
+    };
+    auto tier = [&](const char* k) -> int {
+        if (inv.contains("tiers") && inv["tiers"].is_object() && inv["tiers"].contains(k))
+            return inv["tiers"][k].get<int>();
+        return 0;
+    };
+    auto amount = [&](const char* k) -> int {   // #13: varying-amount item count (0 = none)
+        if (inv.contains("amounts") && inv["amounts"].is_object() && inv["amounts"].contains(k))
+            return inv["amounts"][k].get<int>();
+        return 0;
+    };
+
+    // Swords: own every tier up to the selection, equip the highest.
+    int sw = tier("sword");
+    static const u8 swordOwn[]  = { EQUIP_INV_SWORD_KOKIRI, EQUIP_INV_SWORD_MASTER, EQUIP_INV_SWORD_BIGGORON };
+    static const u8 swordItem[] = { ITEM_SWORD_KOKIRI, ITEM_SWORD_MASTER, ITEM_SWORD_BGS };
+    static const u8 swordVal[]  = { EQUIP_VALUE_SWORD_KOKIRI, EQUIP_VALUE_SWORD_MASTER, EQUIP_VALUE_SWORD_BIGGORON };
+    for (int i = 0; i < sw && i < 3; i++)
+        gSaveContext.inventory.equipment |= OWNED_EQUIP_FLAG(EQUIP_TYPE_SWORD, swordOwn[i]);
+    if (sw > 0) {
+        gSaveContext.equips.buttonItems[0] = swordItem[sw - 1];
+        gSaveContext.equips.equipment &= ~(0xF << (EQUIP_TYPE_SWORD * 4));
+        gSaveContext.equips.equipment |= swordVal[sw - 1] << (EQUIP_TYPE_SWORD * 4);
+    }
+    // #10: the BGS slot shows the breakable Giant's Knife (broken icon) unless bgsFlag is set; for
+    // Biggoron tier, set bgsFlag + full swordHealth so the player actually gets Biggoron's Sword.
+    if (sw >= 3) { gSaveContext.bgsFlag = true; gSaveContext.swordHealth = 8; }
+    else { gSaveContext.bgsFlag = false; }
+
+    // Shields: own up to tier, equip the highest (EQUIP_VALUE_SHIELD_DEKU = 1).
+    int sh = tier("shield");
+    static const u8 shieldOwn[] = { EQUIP_INV_SHIELD_DEKU, EQUIP_INV_SHIELD_HYLIAN, EQUIP_INV_SHIELD_MIRROR };
+    for (int i = 0; i < sh && i < 3; i++)
+        gSaveContext.inventory.equipment |= OWNED_EQUIP_FLAG(EQUIP_TYPE_SHIELD, shieldOwn[i]);
+    if (sh > 0) {
+        gSaveContext.equips.equipment &= ~(0xF << (EQUIP_TYPE_SHIELD * 4));
+        gSaveContext.equips.equipment |= sh << (EQUIP_TYPE_SHIELD * 4);
+    }
+
+    // Tunics & boots (Kokiri always owned + equipped; add the others on request).
+    gSaveContext.inventory.equipment |= OWNED_EQUIP_FLAG(EQUIP_TYPE_TUNIC, EQUIP_INV_TUNIC_KOKIRI);
+    gSaveContext.inventory.equipment |= OWNED_EQUIP_FLAG(EQUIP_TYPE_BOOTS, EQUIP_INV_BOOTS_KOKIRI);
+    if (hasToggle("tunic_goron")) gSaveContext.inventory.equipment |= OWNED_EQUIP_FLAG(EQUIP_TYPE_TUNIC, EQUIP_INV_TUNIC_GORON);
+    if (hasToggle("tunic_zora"))  gSaveContext.inventory.equipment |= OWNED_EQUIP_FLAG(EQUIP_TYPE_TUNIC, EQUIP_INV_TUNIC_ZORA);
+    if (hasToggle("boots_iron"))  gSaveContext.inventory.equipment |= OWNED_EQUIP_FLAG(EQUIP_TYPE_BOOTS, EQUIP_INV_BOOTS_IRON);
+    if (hasToggle("boots_hover")) gSaveContext.inventory.equipment |= OWNED_EQUIP_FLAG(EQUIP_TYPE_BOOTS, EQUIP_INV_BOOTS_HOVER);
+    gSaveContext.equips.equipment &= ~(0xF << (EQUIP_TYPE_TUNIC * 4));
+    gSaveContext.equips.equipment |= 1 << (EQUIP_TYPE_TUNIC * 4);   // EQUIP_VALUE_TUNIC_KOKIRI
+    gSaveContext.equips.equipment &= ~(0xF << (EQUIP_TYPE_BOOTS * 4));
+    gSaveContext.equips.equipment |= 1 << (EQUIP_TYPE_BOOTS * 4);   // EQUIP_VALUE_BOOTS_KOKIRI
+
+    // #21: injected player name (default "Link"). OoT filename encoding: 0-9=0x00.., A-Z=0x0A..,
+    // a-z=0x24.., space/other=0x3E; padded to 8. Without it the save name is blank.
+    {
+        std::string pn = inv.value("playerName", std::string("Link"));
+        if (pn.empty()) pn = "Link";
+        for (int i = 0; i < 8; i++) {
+            u8 c = 0x3E;
+            if (i < (int)pn.size()) {
+                char ch = pn[i];
+                if (ch >= '0' && ch <= '9') c = (u8)(ch - '0');
+                else if (ch >= 'A' && ch <= 'Z') c = (u8)(0x0A + (ch - 'A'));
+                else if (ch >= 'a' && ch <= 'z') c = (u8)(0x24 + (ch - 'a'));
+            }
+            gSaveContext.playerName[i] = c;
+            sMhPlayerName[i] = c;   // stash so the render probe can re-assert after SaveManager's load
+        }
+        sMhNameSet = true;
+    }
+
+    // #5: Z-targeting mode (0 = Switch/Toggle, 1 = Hold). Stash it so the render probe can re-assert it
+    // after SoH's global-settings load (which runs later in the boot) reverts this write.
+    sMhZTarget = inv.value("zTarget", 0);
+    gSaveContext.zTargetSetting = (u8)sMhZTarget;
+
+    // Ocarina tier.
+    int oc = tier("ocarina");
+    if (oc == 1) INV_CONTENT(ITEM_OCARINA_FAIRY) = ITEM_OCARINA_FAIRY;
+    else if (oc >= 2) INV_CONTENT(ITEM_OCARINA_TIME) = ITEM_OCARINA_TIME;
+
+    // Magic tier: 1 = single (the first upgrade), 2 = double. Same fields BossRush/debugSaveEditor set:
+    // flag acquired, set magicLevel, derive magicCapacity = level*0x30 so the bar draws, fill the meter.
+    int mg = tier("magic");
+    if (mg >= 1) {
+        gSaveContext.isMagicAcquired = 1;
+        gSaveContext.magicLevel = (mg >= 2) ? 2 : 1;
+        if (mg >= 2) gSaveContext.isDoubleMagicAcquired = 1;
+        gSaveContext.magicCapacity = gSaveContext.magicLevel * 0x30;   // draw the bar (debugSaveEditor)
+        gSaveContext.magic = gSaveContext.magicCapacity;
+    }
+
+    // Upgrades (wallet / strength / scale / quiver / bomb bag / bullet bag).
+    if (tier("wallet"))    Inventory_ChangeUpgrade(UPG_WALLET, tier("wallet"));
+    if (tier("strength"))  Inventory_ChangeUpgrade(UPG_STRENGTH, tier("strength"));
+    if (tier("scale"))     Inventory_ChangeUpgrade(UPG_SCALE, tier("scale"));
+    if (tier("quiver"))    Inventory_ChangeUpgrade(UPG_QUIVER, tier("quiver"));
+    if (tier("bombbag"))   Inventory_ChangeUpgrade(UPG_BOMB_BAG, tier("bombbag"));
+    if (tier("bulletbag")) Inventory_ChangeUpgrade(UPG_BULLET_BAG, tier("bulletbag"));
+
+    // Hookshot / Longshot share one inventory slot (SLOT_HOOKSHOT) — Longshot is the upgrade — so it's a tier:
+    // 1 = Hookshot, 2 = Longshot. INV_CONTENT for either item writes the same slot.
+    int hookTier = tier("hookshot");
+    if (hookTier == 1)      INV_CONTENT(ITEM_HOOKSHOT) = ITEM_HOOKSHOT;
+    else if (hookTier >= 2) INV_CONTENT(ITEM_LONGSHOT) = ITEM_LONGSHOT;
+
+    // C-items (with a sensible starting ammo where applicable).
+    struct ItemDef { const char* key; u8 item; s8 ammo; };
+    static const ItemDef kItems[] = {
+        { "stick", ITEM_STICK, 10 }, { "nut", ITEM_NUT, 20 }, { "bomb", ITEM_BOMB, 20 }, { "bow", ITEM_BOW, 30 },
+        { "fire_arrow", ITEM_ARROW_FIRE, 0 }, { "dins_fire", ITEM_DINS_FIRE, 0 }, { "slingshot", ITEM_SLINGSHOT, 30 },
+        { "bombchu", ITEM_BOMBCHU, 20 }, { "ice_arrow", ITEM_ARROW_ICE, 0 },   // hookshot/longshot: tier above
+        { "farores_wind", ITEM_FARORES_WIND, 0 }, { "boomerang", ITEM_BOOMERANG, 0 }, { "lens", ITEM_LENS, 0 },
+        { "bean", ITEM_BEAN, 10 }, { "hammer", ITEM_HAMMER, 0 }, { "light_arrow", ITEM_ARROW_LIGHT, 0 },
+        { "nayrus_love", ITEM_NAYRUS_LOVE, 0 },
+    };
+    for (auto& it : kItems)
+        if (hasToggle(it.key)) { INV_CONTENT(it.item) = it.item; if (it.ammo) AMMO(it.item) = it.ammo; }
+    // Nayru's Love: also set the "obtained" randomizer-inf flag. The Nayru <-> Roc's Feather kaleido cycle
+    // (RocsFeatherCycle.c) needs RAND_INF_OBTAINED_NAYRUS_LOVE to cycle BACK from Roc's to Nayru's — without
+    // it, Roc's permanently supersedes Nayru's once selected. (Roc's sets its own flag in the block below.)
+    if (hasToggle("nayrus_love")) Flags_SetRandomizerInf(RAND_INF_OBTAINED_NAYRUS_LOVE);
+    // Bottles: OoT has four independent bottle slots (SLOT_BOTTLE_1..4). Each is its own toggle so the player
+    // can start with any number of them. SLOT_BOTTLE_1 is also the FD mask's host slot (they cycle there).
+    if (hasToggle("bottle1")) gSaveContext.inventory.items[SLOT_BOTTLE_1] = ITEM_BOTTLE;
+    if (hasToggle("bottle2")) gSaveContext.inventory.items[SLOT_BOTTLE_2] = ITEM_BOTTLE;
+    if (hasToggle("bottle3")) gSaveContext.inventory.items[SLOT_BOTTLE_3] = ITEM_BOTTLE;
+    if (hasToggle("bottle4")) gSaveContext.inventory.items[SLOT_BOTTLE_4] = ITEM_BOTTLE;
+
+    // #13: varying-amount items — the editor's count spinner sets ammo[] and auto-grants the smallest
+    // capacity upgrade able to hold it (merged with the explicit tier upgrades above; highest wins).
+    struct AmmoDef { const char* key; u8 item; int upg; u8 caps[4]; };
+    static const AmmoDef kAmmo[] = {
+        { "stick", ITEM_STICK, UPG_STICKS, {0,10,20,30} }, { "nut", ITEM_NUT, UPG_NUTS, {0,20,30,40} },
+        { "bomb", ITEM_BOMB, UPG_BOMB_BAG, {0,20,30,40} },     { "bow", ITEM_BOW, UPG_QUIVER, {0,30,40,50} },
+        { "slingshot", ITEM_SLINGSHOT, UPG_BULLET_BAG, {0,30,40,50} }, { "bombchu", ITEM_BOMBCHU, -1, {0,50,50,50} },
+    };
+    for (auto& a : kAmmo) {
+        int amt = amount(a.key);
+        if (amt <= 0) continue;
+        if (amt > a.caps[3]) amt = a.caps[3];
+        INV_CONTENT(a.item) = a.item;
+        AMMO(a.item) = (s8)amt;
+        if (a.upg >= 0) {
+            int lvl = 3;
+            for (int l = 1; l < 4; l++) if (a.caps[l] >= amt) { lvl = l; break; }
+            if (lvl > CUR_UPG_VALUE(a.upg)) Inventory_ChangeUpgrade((u16)a.upg, lvl);
+        }
+    }
+
+    // Songs / medallions / stones (quest-item bits).
+    struct QuestDef { const char* key; int q; };
+    static const QuestDef kQuest[] = {
+        { "song_lullaby", QUEST_SONG_LULLABY }, { "song_epona", QUEST_SONG_EPONA }, { "song_saria", QUEST_SONG_SARIA },
+        { "song_suns", QUEST_SONG_SUN }, { "song_time", QUEST_SONG_TIME }, { "song_storms", QUEST_SONG_STORMS },
+        { "song_minuet", QUEST_SONG_MINUET }, { "song_bolero", QUEST_SONG_BOLERO }, { "song_serenade", QUEST_SONG_SERENADE },
+        { "song_requiem", QUEST_SONG_REQUIEM }, { "song_nocturne", QUEST_SONG_NOCTURNE }, { "song_prelude", QUEST_SONG_PRELUDE },
+        { "med_forest", QUEST_MEDALLION_FOREST }, { "med_fire", QUEST_MEDALLION_FIRE }, { "med_water", QUEST_MEDALLION_WATER },
+        { "med_spirit", QUEST_MEDALLION_SPIRIT }, { "med_shadow", QUEST_MEDALLION_SHADOW }, { "med_light", QUEST_MEDALLION_LIGHT },
+        { "stone_emerald", QUEST_KOKIRI_EMERALD }, { "stone_ruby", QUEST_GORON_RUBY }, { "stone_sapphire", QUEST_ZORA_SAPPHIRE },
+        { "agony", QUEST_STONE_OF_AGONY },
+    };
+    for (auto& qq : kQuest)
+        if (hasToggle(qq.key)) gSaveContext.inventory.questItems |= (1 << qq.q);
+
+    // Trade-quest slots (the editor's trade_child / trade_adult dropdowns). The OoT trade slots each hold
+    // one item id: child slot = ITEM 0x20+idx (Weird Egg 0x21 .. Mask of Truth 0x2B), adult slot =
+    // 0x2C+idx (Pocket Egg 0x2D .. Claim Check 0x37). Without this the editor's chosen trade item (e.g.
+    // Bunny Hood) never reached the OTR save — only the N64 poke path applied it.
+    int tradeChild = tier("trade_child");
+    if (tradeChild > 0) gSaveContext.inventory.items[SLOT_TRADE_CHILD] = (u8)(0x20 + tradeChild);
+    int tradeAdult = tier("trade_adult");
+    if (tradeAdult > 0) gSaveContext.inventory.items[SLOT_TRADE_ADULT] = (u8)(0x2C + tradeAdult);
+
+    // Roc's Feather — Megaton Hammer's first optional SoH-exclusive item. It has no slot of its own; it
+    // shares SLOT_NAYRUS_LOVE. Turn on the enhancement CVar and re-run ShipInit for it so the jump hooks
+    // register even outside the randomizer, set the obtained flag, and drop the item into the Nayru slot.
+    if (hasToggle("rocs_feather")) {
+        CVarSetInteger(CVAR_ENHANCEMENT("MhRocsFeather"), 1);
+        ShipInit::Init(CVAR_ENHANCEMENT("MhRocsFeather"));
+        Flags_SetRandomizerInf(RAND_INF_OBTAINED_ROCS_FEATHER);
+        // Roc's Feather shares SLOT_NAYRUS_LOVE. Only drop it into the slot if empty — if the player also
+        // has Nayru's Love, leave that in place; the RAND_INF flag + the un-gated kaleido cycle let them
+        // switch between the two (otherwise Roc's would permanently displace Nayru's Love).
+        if (INV_CONTENT(ITEM_NAYRUS_LOVE) == ITEM_NONE) {
+            INV_CONTENT(ITEM_NAYRUS_LOVE) = ITEM_ROCS_FEATHER;
+        }
+        MhBootLog("[mh_inv] Roc's Feather enabled (CVar MhRocsFeather); slot now holds item " +
+                  std::to_string((int)INV_CONTENT(ITEM_NAYRUS_LOVE)));
+    }
+
+    // Fierce Deity's Mask (SoH-exclusive optional item, from the soh_fd port). Grant it exactly like any
+    // other inventory item — set only the owned flag; the player equips it themselves from the pause menu.
+    if (hasToggle("fd_mask")) {
+        // Just mark it owned, exactly like checking any other inventory item. soh_fd then surfaces the
+        // mask in the kaleido grid on the first bottle slot (A-scroll to reveal it, gated only on
+        // hasFierceDeityMask — see FierceDeityMaskCycle.c), the same manual flow as Roc's Feather.
+        // No auto C-button assignment, no give-item animation.
+        gSaveContext.ship.hasFierceDeityMask = 1;
+        MhBootLog("[mh_inv] Fierce Deity's Mask granted (owned; equip from the inventory like any item)");
+    }
+
+    // Dump the resulting save fields so the editor can verify injection end-to-end via the boot log.
+    MhBootLog("[mh_inv] applied: healthCap=" + std::to_string(gSaveContext.healthCapacity) +
+              " equipment=0x" + StringHelper::Sprintf("%X", gSaveContext.inventory.equipment) +
+              " upgrades=0x" + StringHelper::Sprintf("%X", gSaveContext.inventory.upgrades) +
+              " questItems=0x" + StringHelper::Sprintf("%X", gSaveContext.inventory.questItems) +
+              " ocarinaSlot=" + std::to_string(INV_CONTENT(ITEM_OCARINA_FAIRY)) +
+              " bSword=" + std::to_string(gSaveContext.equips.buttonItems[0]) +
+              " bgsFlag=" + std::to_string(gSaveContext.bgsFlag) +
+              " name0=" + std::to_string(gSaveContext.playerName[0]));
+}
+
+// Megaton Hammer: on title-screen startup, if a playtest mod O2R is mounted (it carries an
+// "mh/info" resource), set up a save and warp straight into the packed scene with the chosen
+// age + inventory — no manual console command. Modelled on Enhancements/Warping.cpp's boot path.
+// ── Authored dialogue (Megaton Hammer Message Bank) ───────────────────────────────────────────────
+// The editor emits an "mh/messages" resource: a JSON array of { id (textId), type, pos, icon, text }.
+// At boot we register an OnOpenText hook per id; when an actor opens that textId we build the line with
+// the friendly-markup converter (& newline, ^ new box, %r/%g/%b/%y/%w/%p colour) and load it into the font,
+// telling the engine to skip the normal message-table lookup.
+// One option's outcome: give a GetItem, deduct rupees, set a switch flag, and/or branch to another box.
+struct MhOutcomeC {
+    int give = -1;   // GetItem id to award (-1 = none)
+    int cost = 0;    // rupees to deduct (0 = free)
+    int flag = -1;   // switch flag to set (-1 = none)
+    int next = -1;   // textId to branch to (-1 = none/close)
+};
+struct MhMsgEntry {
+    std::string text;
+    int type = 0;
+    int pos = 0;
+    bool prompt = false;            // true = a two-choice question
+    std::string choice1, choice2;   // option labels (prompt only)
+    MhOutcomeC o1, o2;              // outcome for a plain message / choice 1, and choice 2
+    int doneFlag = -1;
+    int afterId = -1;
+};
+static std::unordered_map<uint16_t, MhMsgEntry> sMhMessages;
+
+// The authored box currently open (0 = none) and whether its outcome has fired this open — read by the
+// per-frame MhDialogueInterpreter below to apply give/charge/branch when the player confirms.
+static uint16_t sMhOpenTextId = 0;
+static bool sMhOutcomeApplied = false;
+
+static void MhOnOpenText(uint16_t* textId, bool* loadFromMessageTable) {
+    auto it = sMhMessages.find(*textId);
+    if (it == sMhMessages.end()) {
+        return; // not an authored id → let the normal table handle it
+    }
+    const MhMsgEntry& e = it->second;
+    // A prompt appends the two-choice control code + the two option lines, so the in-game cursor selects
+    // between them; the interpreter reads msgCtx.choiceIndex and applies that option's outcome.
+    std::string body = e.text;
+    if (e.prompt) {
+        body += CustomMessage::NEWLINE();
+        body += CustomMessage::TWO_WAY_CHOICE();
+        body += e.choice1;
+        body += CustomMessage::NEWLINE();
+        body += e.choice2;
+    }
+    CustomMessage msg(body, (TextBoxType)e.type, (TextBoxPosition)e.pos);
+    msg.AutoFormat();
+    msg.LoadIntoFont();
+    *loadFromMessageTable = false;
+    sMhOpenTextId = *textId;      // arm the interpreter for this box
+    sMhOutcomeApplied = false;
+    MhBootLog("[mh_dlg] open textId=0x" + StringHelper::Sprintf("%X", *textId) + " prompt=" +
+              std::to_string(e.prompt) + " o1.give=" + std::to_string(e.o1.give) + " o1.cost=" + std::to_string(e.o1.cost));
+}
+
+static void MhLoadMessages() {
+    auto ctx = Ship::Context::GetRawInstance();
+    if (ctx == nullptr || ctx->GetResourceManager() == nullptr) {
+        return;
+    }
+    auto file = ctx->GetResourceManager()->GetArchiveManager()->LoadFile("mh/messages");
+    if (file == nullptr || file->Buffer == nullptr || file->Buffer->empty()) {
+        return; // no authored dialogue in this mod
+    }
+    std::string body(file->Buffer->begin(), file->Buffer->end());
+    nlohmann::json arr = nlohmann::json::parse(body, nullptr, false);
+    if (arr.is_discarded() || !arr.is_array()) {
+        MhBootLog("[mh_boot] mh/messages JSON parse error");
+        return;
+    }
+    int count = 0;
+    for (auto& e : arr) {
+        uint16_t id = (uint16_t)e.value("id", 0);
+        if (id == 0) {
+            continue;
+        }
+        MhMsgEntry me;
+        me.text    = e.value("text", std::string(""));
+        me.type    = e.value("type", 0);
+        me.pos     = e.value("pos", 0);
+        me.prompt  = e.value("prompt", false);
+        me.choice1 = e.value("choice1", std::string(""));
+        me.choice2 = e.value("choice2", std::string(""));
+        auto parseOutcome = [](const nlohmann::json& j, MhOutcomeC& o) {
+            if (j.is_object()) {
+                o.give = j.value("give", -1);
+                o.cost = j.value("cost", 0);
+                o.flag = j.value("flag", -1);
+                o.next = j.value("next", -1);
+            }
+        };
+        if (e.contains("o1")) parseOutcome(e["o1"], me.o1);
+        if (e.contains("o2")) parseOutcome(e["o2"], me.o2);
+        me.doneFlag = e.value("doneFlag", -1);
+        me.afterId  = e.value("afterId", -1);
+        sMhMessages[id] = me;
+        GameInteractor::Instance->RegisterGameHookForID<GameInteractor::OnOpenText>(id, MhOnOpenText);
+        count++;
+    }
+    MhBootLog("[mh_msg] registered " + std::to_string(count) + " authored message(s)");
+}
+
+// Optional SoH-exclusive item placements (the editor's "SoH item" dropdown on a chest / freestanding item).
+// Each entry pairs a chest's treasure flag (0..31, or -1 for a non-chest placement given on load) with an
+// optional-item key. MhChestInterpreter grants the item when the chest is opened.
+static std::vector<std::pair<int, std::string>> sMhChests;
+static std::vector<char> sMhChestGranted;
+
+// Grant one optional item by key — the same effect as checking it in the playtest inventory (see
+// MhApplyCustomInventory). Idempotent: re-granting just re-sets the owned flags.
+static void MhGrantOptionalKey(const std::string& key) {
+    if (key == "rocs_feather") {
+        CVarSetInteger(CVAR_ENHANCEMENT("MhRocsFeather"), 1);
+        ShipInit::Init(CVAR_ENHANCEMENT("MhRocsFeather"));
+        Flags_SetRandomizerInf(RAND_INF_OBTAINED_ROCS_FEATHER);
+        if (INV_CONTENT(ITEM_NAYRUS_LOVE) == ITEM_NONE) {
+            INV_CONTENT(ITEM_NAYRUS_LOVE) = ITEM_ROCS_FEATHER;
+        }
+    } else if (key == "fd_mask") {
+        gSaveContext.ship.hasFierceDeityMask = 1;
+    } else {
+        MhBootLog("[mh_chest] unknown optional-item key: " + key);
+        return;
+    }
+    MhBootLog("[mh_chest] granted optional item '" + key + "'");
+}
+
+static void MhLoadChests() {
+    sMhChests.clear();
+    sMhChestGranted.clear();
+    auto ctx = Ship::Context::GetRawInstance();
+    if (ctx == nullptr || ctx->GetResourceManager() == nullptr) {
+        return;
+    }
+    auto file = ctx->GetResourceManager()->GetArchiveManager()->LoadFile("mh/chests");
+    if (file == nullptr || file->Buffer == nullptr || file->Buffer->empty()) {
+        return; // no custom-item placements in this mod
+    }
+    std::string body(file->Buffer->begin(), file->Buffer->end());
+    nlohmann::json arr = nlohmann::json::parse(body, nullptr, false);
+    if (arr.is_discarded() || !arr.is_array()) {
+        MhBootLog("[mh_boot] mh/chests JSON parse error");
+        return;
+    }
+    for (auto& e : arr) {
+        std::string key = e.value("key", std::string(""));
+        if (key.empty()) {
+            continue;
+        }
+        sMhChests.push_back({ e.value("flag", -1), key });
+    }
+    sMhChestGranted.assign(sMhChests.size(), 0);
+    MhBootLog("[mh_chest] loaded " + std::to_string(sMhChests.size()) + " custom-item placement(s)");
+}
+
+extern "C" void Randomizer_DrawRocsFeather(PlayState* play, GetItemEntry* getItemEntry);
+
+// Fill *out with the GetItemEntry for the non-standard SoH item on the chest with this treasure flag (Fierce
+// Deity's Mask or Roc's Feather), or return false. Used by the VB_OPEN_CHEST hook so the chest gives the real
+// item through its own get-item flow. Both ride a valid vanilla vehicle model that drawFunc overrides, and use
+// a MOD_NONE ITEM_* id so the give routes through Item_Give() (ITEM_MASK_DEITY -> FD equip; ITEM_ROCS_FEATHER).
+// The actual owned flags are then ensured (idempotently) by MhChestInterpreter after the get finishes.
+static bool MhChestGetItemEntry(s32 treasureFlag, GetItemEntry* out) {
+    for (auto& c : sMhChests) {
+        if (c.first != (int)treasureFlag) {
+            continue;
+        }
+        if (c.second == "fd_mask") {
+            *out = FierceDeity_GetMaskGetItemEntry();
+            return true;
+        } else if (c.second == "rocs_feather") {
+            GetItemEntry rocs = GET_ITEM(ITEM_ROCS_FEATHER, OBJECT_GI_BOMB_2, GID_STONE_OF_AGONY,
+                                         TEXT_RANDOMIZER_CUSTOM_ITEM, 0x80, CHEST_ANIM_LONG, ITEM_CATEGORY_MAJOR,
+                                         MOD_NONE, GI_STONE_OF_AGONY);
+            rocs.drawFunc = Randomizer_DrawRocsFeather; // draw the real Roc's Feather over the vehicle model
+            *out = rocs;
+            return true;
+        }
+    }
+    return false;
+}
+
+// Per-frame: for a non-chest placement (flag == -1) grant the item immediately; for a chest (flag >= 0) the
+// chest's own get-item flow already shows + gives the item (VB_OPEN_CHEST set the entry), so here we just
+// ensure the owned flags once the get-cutscene ends. Idempotent; each placement fires once per session.
+// Chest-flag state captured the first frame we're actually in the playtest scene, so a treasure flag that
+// is ALREADY set on entry never counts as "the player opened this chest this session" (which would grant the
+// item without the chest ever being touched). Only a clear->set transition after entry is a real open.
+static u32  sMhChestBaseline = 0;
+static bool sMhChestBaselineTaken = false;
+
+static void MhChestInterpreter() {
+    if (gPlayState == nullptr || sMhChests.empty()) {
+        return;
+    }
+    // Only operate once we're actually inside the playtest scene — otherwise transient chest-flag state in a
+    // title/transition/other scene could be mistaken for an open.
+    if (sMhPlaytestScene < 0 || gPlayState->sceneNum != sMhPlaytestScene) {
+        sMhChestBaselineTaken = false; // re-baseline on the next entry
+        return;
+    }
+    if (!sMhChestBaselineTaken) {
+        sMhChestBaseline = gPlayState->actorCtx.flags.chest;
+        sMhChestBaselineTaken = true;
+        MhBootLog("[mh_chest] baseline chest flags on scene entry = 0x" +
+                  StringHelper::Sprintf("%X", sMhChestBaseline));
+    }
+    for (size_t i = 0; i < sMhChests.size(); i++) {
+        if (sMhChestGranted[i]) {
+            continue;
+        }
+        int flag = sMhChests[i].first;
+        const std::string& key = sMhChests[i].second;
+        if (flag < 0) {
+            // Non-chest placement (freestanding / given on load): grant silently.
+            MhGrantOptionalKey(key);
+            sMhChestGranted[i] = 1;
+        } else if (Flags_GetTreasure(gPlayState, flag) && !(sMhChestBaseline & (1u << flag))) {
+            // The chest went from closed->open THIS session: its own get-item flow already showed + gave the
+            // item (VB_OPEN_CHEST set the entry). Wait until that get-cutscene ends, then ensure the owned
+            // flags (hasFierceDeityMask / Roc's RAND_INF + slot) once — Item_Give from the flow may not set
+            // them. Idempotent, and silent (no second animation).
+            Player* player = GET_PLAYER(gPlayState);
+            if (player == NULL || (player->stateFlags1 & PLAYER_STATE1_GETTING_ITEM)) {
+                continue; // still in the chest get-item cutscene — try again next frame
+            }
+            MhGrantOptionalKey(key);
+            sMhChestGranted[i] = 1;
+        }
+    }
+}
+
+// #20: the debug scene-select list's appended Megaton Hammer entry name (defined in ovl_select/z_select.c).
+extern "C" char gMhWarpName[64];
+
+// Cross-game / custom music: the runtime seqId->resource-path map, built by AudioLoad_Init from the archives.
+// The boot hook force-rebinds a host slot to the editor's injected OSEQ resource (see MhPlaytestBootHook).
+extern "C" char** sequenceMap;
+extern "C" size_t sequenceMapSize;
+
+static void MhPlaytestBootHook(void* gameState) {
+    static bool done = false;
+    if (done) {
+        return;
+    }
+
+    auto ctx = Ship::Context::GetRawInstance();
+    if (ctx == nullptr || ctx->GetResourceManager() == nullptr) {
+        return;
+    }
+    auto file = ctx->GetResourceManager()->GetArchiveManager()->LoadFile("mh/info");
+    if (file == nullptr || file->Buffer == nullptr || file->Buffer->empty()) {
+        return; // no playtest mod present → normal boot
+    }
+    done = true;
+
+    MhLoadMessages();   // register any authored dialogue (mh/messages) before warping in
+    MhLoadChests();     // load optional-item chest/freestanding placements (mh/chests)
+
+    std::string info(file->Buffer->begin(), file->Buffer->end());
+    MhBootLog("[mh_boot] mh/info loaded: " + info);
+
+    nlohmann::json j = nlohmann::json::parse(info, nullptr, false);
+    if (j.is_discarded()) {
+        MhBootLog("[mh_boot] FAIL: mh/info JSON parse error");
+        return;
+    }
+    s32 sceneId = j.value("sceneId", 0x52);
+    bool adult = j.value("adult", false);
+    bool append = j.value("append", false);
+    sMhPlaytestScene = append ? SCENE_MH_APPEND : sceneId;   // scene the probe watches for its re-asserts
+    std::string inv = j.value("inventory", std::string("debug"));
+    MhBootLog("[mh_boot] sceneId=0x" + StringHelper::Sprintf("%X", sceneId) + " adult=" +
+              std::to_string(adult) + " inventory=" + inv + " append=" + std::to_string(append));
+
+    // Megaton Hammer water scroll: OoT animates water via the scene's DRAW CONFIG. SDC_CALM_WATER (0x2F)
+    // scrolls segment 0x08 (a two-layer tile scroll on POLY_XLU_DISP), which the editor's translucent water
+    // DL (mesh xlu path) references via gsSPDisplayList(0x08). gSceneTable[id].config is read at spawn
+    // (OTRPlay_SpawnScene), so set it here on the scene the water level loads into. Only when the editor
+    // marked the level as having scrolling water (else leave the scene's own draw config untouched).
+    if (j.value("waterScroll", false)) {
+        s32 wsScene = append ? SCENE_MH_APPEND : sceneId;
+        gSceneTable[wsScene].config = 0x2F; // SDC_CALM_WATER
+        MhBootLog("[mh_boot] waterScroll: gSceneTable[0x" + StringHelper::Sprintf("%X", wsScene) +
+                  "].config = SDC_CALM_WATER");
+    }
+
+    // Megaton Hammer cross-game / custom music: the editor packed the chosen sequence as an OSEQ resource
+    // (audio/sequences/mh_cross) that claims a valid vanilla host seqId, and recorded it in mh/info "music".
+    // AudioLoad_Init already built sequenceMap from every archive, but two resources sharing a seqNumber are
+    // last-writer-wins (nondeterministic). Force the host slot to our resource so the scene's 0x15 (which the
+    // editor set to that same host id) resolves to the injected track. The level is custom, so displacing that
+    // vanilla sequence for this session is harmless.
+    if (j.contains("music") && j["music"].is_object() && sequenceMap != nullptr) {
+        int mSeq = j["music"].value("seqId", -1);
+        std::string mPath = j["music"].value("path", std::string());
+        if (mSeq >= 0 && (size_t)mSeq < sequenceMapSize && !mPath.empty()) {
+            if (sequenceMap[mSeq] != nullptr) {
+                free(sequenceMap[mSeq]);
+            }
+            sequenceMap[mSeq] = strdup(mPath.c_str());
+            MhBootLog("[mh_boot] music: sequenceMap[0x" + StringHelper::Sprintf("%X", mSeq) + "] -> " + mPath);
+        } else {
+            MhBootLog("[mh_boot] music: invalid seqId/path (seqId=" + std::to_string(mSeq) +
+                      ", mapSize=" + std::to_string(sequenceMapSize) + ")");
+        }
+    }
+
+    // #20: label this level at the tail of the debug scene-select list (default "Megaton Project").
+    {
+        std::string dn = j.value("displayName", std::string("Megaton Project"));
+        if (dn.empty()) dn = "Megaton Project";
+        snprintf(gMhWarpName, sizeof(gMhWarpName), "126:%.58s", dn.c_str());
+        MhBootLog("[mh_boot] warp-list name = " + std::string(gMhWarpName));
+    }
+
+    // Resolve the warp entrance. Append mode targets the reserved SCENE_MH_APPEND scene, reached via
+    // the reserved ENTR_MH_APPEND_0 entrance — both added to the (grown) scene/entrance tables in the
+    // Megaton Hammer fork, so nothing existing is repurposed. gSceneTable[SCENE_MH_APPEND] already
+    // references scenes/shared/mh_append_scene/mh_append_scene, which our mod O2R overrode with the
+    // appended level. Replace mode finds the first entrance that leads to the chosen real scene.
+    s16 entrance = -1;
+    if (append) {
+        entrance = ENTR_MH_APPEND_0;
+        MhBootLog("[mh_boot] append mode — warping via reserved ENTR_MH_APPEND_0 -> SCENE_MH_APPEND");
+    } else {
+        for (s16 i = 0; i < ENTR_MAX; i++) {
+            if (gEntranceTable[i].scene == sceneId) {
+                entrance = i;
+                break;
+            }
+        }
+        if (entrance < 0) {
+            ERROR_MESSAGE("[SOH] No entrance found for scene id 0x%X.", sceneId);
+            MhBootLog("[mh_boot] FAIL: no entrance for replace-mode scene 0x" + StringHelper::Sprintf("%X", sceneId));
+            return;
+        }
+    }
+    MhBootLog("[mh_boot] entrance=0x" + StringHelper::Sprintf("%X", entrance));
+
+    // Boot a temporary save (debug inventory, or empty), set age, and warp — mirrors Warping.cpp.
+    gSaveContext.gameMode = GAMEMODE_NORMAL;
+    gSaveContext.fileNum = 0xFE;
+    if (inv == "empty") {
+        Sram_InitNewSave();
+    } else if (inv == "custom") {
+        Sram_InitNewSave();   // start blank, then layer on the editor's custom loadout
+        if (j.contains("inv") && j["inv"].is_object()) {
+            MhApplyCustomInventory(j["inv"]);
+            MhBootLog("[mh_boot] applied custom inventory");
+        } else {
+            MhBootLog("[mh_boot] custom inventory selected but no 'inv' payload — left empty");
+        }
+    } else {
+        Sram_InitDebugSave(); // "debug" → full debug inventory
+    }
+    gSaveContext.fileNum = 0xFF;
+    gSaveContext.sceneSetupIndex = 0;
+    gSaveContext.cutsceneIndex = 0;
+    gSaveContext.linkAge = adult ? 0 : 1; // LINK_AGE_ADULT = 0, LINK_AGE_CHILD = 1
+    // Normalized playtest time-of-day (editor SceneSettings.PlaytestTimeOfDay): one u16 over a 24h day
+    // from midnight (0x8000=noon), the same value 2Ship applies to save.time — so every engine starts at
+    // the identical time. nightFlag follows it (0x4000..0xC000 ≈ 6:00..18:00 is day).
+    u16 mhTimeOfDay = (j.contains("timeOfDay") && j["timeOfDay"].is_number_integer())
+                          ? (u16)j["timeOfDay"].get<int>() : 0x8000;
+    gSaveContext.nightFlag = (mhTimeOfDay < 0x4555 || mhTimeOfDay > 0xC000) ? 1 : 0;
+    gSaveContext.skyboxTime = gSaveContext.dayTime = mhTimeOfDay;
+    for (int b = 0; b < ARRAY_COUNT(gSaveContext.buttonStatus); b++) {
+        gSaveContext.buttonStatus[b] = BTN_ENABLED;
+    }
+
+    // MH playtest gamestate normalization: every authored chest must start closed and every switch
+    // unpressed. Sram_InitDebugSave (and a loaded save) can leave the test scene's chest/switch flags
+    // set, so En_Box would render already-opened. Mirror the 2Ship hook and the N64 PJ64 Play_Init
+    // detour (which zero these wholesale) by clearing chest+swch for every scene. clear/collect/floors
+    // are left as-is (room-clear/collectible/map state isn't part of a chest's open/closed identity).
+    for (int i = 0; i < ARRAY_COUNT(gSaveContext.sceneFlags); i++) {
+        gSaveContext.sceneFlags[i].chest = 0;
+        gSaveContext.sceneFlags[i].swch = 0;
+    }
+
+    gSaveContext.entranceIndex = entrance;
+    gSaveContext.seqId = (u8)NA_BGM_DISABLED;
+    gSaveContext.natureAmbienceId = 0xFF;
+    gSaveContext.showTitleCard = true;
+    gWeatherMode = 0;
+
+    TitleContext* titleContext = (TitleContext*)gameState;
+    titleContext->state.running = false;
+    SET_NEXT_GAMESTATE(&titleContext->state, Play_Init, PlayState);
+    GameInteractor_ExecuteOnLoadGame(gSaveContext.fileNum);
+    MhBootLog("[mh_boot] OK: warp triggered to scene 0x" + StringHelper::Sprintf("%X", sceneId));
+}
+
+// MH render probe: once we've actually entered the playtest scene and run a few frames, log it once.
+// Positive confirmation the level loaded AND is rendering frames (not just that the warp fired) — lets
+// the headless harness distinguish a real load from a post-warp freeze.
+static void MhPlaytestRenderProbe() {
+    static int framesInScene = 0;
+    static bool logged = false;
+    if (gPlayState == nullptr) {
+        return;
+    }
+    // Watch the ACTUAL playtest scene (append → SCENE_MH_APPEND, replace → the replaced scene id). Keying off
+    // SCENE_MH_APPEND alone skipped the re-asserts in replace mode (e.g. the injected player name never stuck).
+    if (sMhPlaytestScene < 0 || gPlayState->sceneNum != sMhPlaytestScene) {
+        framesInScene = 0;
+        return;
+    }
+    framesInScene++;
+    // Re-assert the name EVERY frame in the playtest scene (not just the first 90): a textbox's
+    // MESSAGE_NAME can open at any time, and SaveManager may re-sync the save more than once.
+    if (sMhNameSet) {
+        for (int i = 0; i < 8; i++) gSaveContext.playerName[i] = sMhPlayerName[i];
+    }
+    if (sMhZTarget >= 0 && framesInScene <= 90) {
+        gSaveContext.zTargetSetting = (u8)sMhZTarget;
+    }
+    if (logged) {
+        return;
+    }
+    if (framesInScene >= 30) {
+        MhBootLog("[mh_boot] RENDER OK: in SCENE_MH_APPEND room=" +
+                  std::to_string((int)gPlayState->roomCtx.curRoom.num) + " after 30 frames");
+        // MH diag: the user reports a black sky + an untextured "blue blob" Link in this scene. Log the
+        // skybox + player + tunic state so the cause (skybox never set up / wrong id / Link draw) is
+        // visible in the boot log without a debugger. play->skyboxId is the scene's requested skybox
+        // (should be 1 = SKYBOX_NORMAL_SKY); skyboxCtx.skyboxId is what actually got loaded.
+        Player* mhPlayer = GET_PLAYER(gPlayState);
+        MhBootLog("[mh_diag] skyboxId=" + std::to_string((int)gPlayState->skyboxId) +
+                  " skyboxCtx.skyboxId=" + std::to_string((int)gPlayState->skyboxCtx.skyboxId) +
+                  " player=" + (mhPlayer ? "yes" : "NULL") +
+                  " equip=0x" + StringHelper::Sprintf("%X", gSaveContext.equips.equipment) +
+                  " tunicOwned=0x" + StringHelper::Sprintf("%X", gSaveContext.inventory.equipment));
+        // Which age×time setup (alt-header) actually loaded — confirms the 0x18 selection per playtest pick.
+        MhBootLog("[mh_diag] sceneSetupIndex=" + std::to_string((int)gSaveContext.sceneSetupIndex) +
+                  " linkAge=" + std::to_string((int)gSaveContext.linkAge) +
+                  " nightFlag=" + std::to_string((int)gSaveContext.nightFlag));
+        logged = true;
+    }
+}
+
+// Apply one authored dialogue outcome: charge rupees (only if affordable), award an item, set a switch
+// flag, and/or branch to another textbox. Mirrors the portable ovl_En_MhTalk interpreter, but driven from
+// the mh/messages resource so ANY actor that opens an authored textId (a sign, a talk region, a built-in
+// En_MhTalk) gets the full tree behaviour.
+static void MhApplyOutcome(const MhOutcomeC& o) {
+    MhBootLog("[mh_dlg] apply outcome: give=" + std::to_string(o.give) + " cost=" + std::to_string(o.cost) +
+              " flag=" + std::to_string(o.flag) + " next=" + std::to_string(o.next) +
+              " (rupees=" + std::to_string(gSaveContext.rupees) + ")");
+    if (o.cost > 0) {
+        if (gSaveContext.rupees < o.cost) {
+            MhBootLog("[mh_dlg]   can't afford — outcome skipped");
+            return; // can't afford — leave the transaction unfulfilled
+        }
+        Rupees_ChangeBy(-o.cost);
+    }
+    if (o.give >= 0) {
+        GetItemEntry gie = ItemTableManager::Instance->RetrieveItemEntry(MOD_NONE, o.give);
+        MhBootLog("[mh_dlg]   giving item id=" + std::to_string(o.give) + " (entry.itemId=" +
+                  std::to_string((int)gie.itemId) + ")");
+        GiveItemEntryWithoutActor(gPlayState, gie);
+    }
+    if (o.flag >= 0) {
+        Flags_SetSwitch(gPlayState, o.flag);
+    }
+    if (o.next >= 0) {
+        Message_ContinueTextbox(gPlayState, (u16)o.next);
+    }
+}
+
+// Per-frame dialogue interpreter: watches the authored box armed by MhOnOpenText and, when the player
+// confirms a choice (prompt) or advances past a plain message, applies that option's outcome exactly once.
+static void MhDialogueInterpreter() {
+    if (gPlayState == nullptr || sMhOpenTextId == 0) {
+        return;
+    }
+    auto it = sMhMessages.find(sMhOpenTextId);
+    if (it == sMhMessages.end()) {
+        sMhOpenTextId = 0;
+        return;
+    }
+    const MhMsgEntry& e = it->second;
+    MessageContext* msgCtx = &gPlayState->msgCtx;
+    u8 state = Message_GetState(msgCtx);
+
+    if (!sMhOutcomeApplied) {
+        if (e.prompt) {
+            if (state == TEXT_STATE_CHOICE && Message_ShouldAdvance(gPlayState)) {
+                MhApplyOutcome((msgCtx->choiceIndex & 1) ? e.o2 : e.o1);
+                sMhOutcomeApplied = true;
+            }
+        } else {
+            if (state == TEXT_STATE_DONE && Message_ShouldAdvance(gPlayState)) {
+                MhApplyOutcome(e.o1);
+                sMhOutcomeApplied = true;
+            }
+        }
+    }
+    // Disarm once the box is fully gone so the next open re-arms cleanly. (A branch reopens via MhOnOpenText,
+    // which re-arms with the new id.)
+    if (state == TEXT_STATE_NONE) {
+        sMhOpenTextId = 0;
+        sMhOutcomeApplied = false;
+    }
+}
