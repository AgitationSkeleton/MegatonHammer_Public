+/*
+ * File: z_en_mhtalk.c
+ * Overlay: ovl_En_MhTalk
+ * Description: Megaton Hammer dialogue point. A visible, talkable beacon that opens
+ *              textId 0x1000 + (params & 0xFF) when talked to. The outcome of the
+ *              conversation (give item / rupees / branch) is handled elsewhere by the
+ *              per-frame debug-console interpreter; this actor only offers the talk
+ *              and opens its textId.
+ */
+
+#include "z_en_mhtalk.h"
+#include "objects/gameplay_keep/gameplay_keep.h"
+
+#define FLAGS (ACTOR_FLAG_ATTENTION_ENABLED | ACTOR_FLAG_FRIENDLY | ACTOR_FLAG_UPDATE_CULLING_DISABLED)
+
+void EnMhTalk_Init(Actor* thisx, PlayState* play);
+void EnMhTalk_Destroy(Actor* thisx, PlayState* play);
+void EnMhTalk_Update(Actor* thisx, PlayState* play);
+void EnMhTalk_Draw(Actor* thisx, PlayState* play);
+
+const ActorInit En_MhTalk_InitVars = {
+    ACTOR_EN_MHTALK,
+    ACTORCAT_NPC,
+    FLAGS,
+    OBJECT_GAMEPLAY_KEEP,
+    sizeof(EnMhTalk),
+    (ActorFunc)EnMhTalk_Init,
+    (ActorFunc)EnMhTalk_Destroy,
+    (ActorFunc)EnMhTalk_Update,
+    (ActorFunc)EnMhTalk_Draw,
+    NULL,
+};
+
+static ColliderCylinderInit sCylinderInit = {
+    {
+        COLTYPE_NONE,
+        AT_NONE,
+        AC_NONE,
+        OC1_ON | OC1_TYPE_ALL,
+        OC2_TYPE_1,
+        COLSHAPE_CYLINDER,
+    },
+    {
+        ELEMTYPE_UNK0,
+        { 0x00000000, 0x00, 0x00 },
+        { 0x00000000, 0x00, 0x00 },
+        TOUCH_NONE,
+        BUMP_NONE,
+        OCELEM_ON,
+    },
+    { 20, 40, 0, { 0, 0, 0 } },
+};
+
+void EnMhTalk_Init(Actor* thisx, PlayState* play) {
+    EnMhTalk* this = (EnMhTalk*)thisx;
+
+    Collider_InitCylinder(play, &this->collider);
+    Collider_SetCylinder(play, &this->collider, &this->actor, &sCylinderInit);
+
+    // Visible beacon: draw the gameplay_keep rupee display list at a clearly-readable size.
+    Actor_SetScale(&this->actor, 0.06f);
+    ActorShape_Init(&this->actor.shape, 0.0f, ActorShadow_DrawCircle, 12.0f);
+
+    // Aim the talk/attention focus at the floating rupee, not the ground point.
+    Actor_SetFocus(&this->actor, 30.0f);
+
+    // Dialogue authored by the MH editor / debug-console interpreter lives at 0x1000 + index.
+    this->actor.textId = 0x1000 + (this->actor.params & 0xFF);
+
+    this->talkFlag = false;
+    this->talkTimer = 0;
+}
+
+void EnMhTalk_Destroy(Actor* thisx, PlayState* play) {
+    EnMhTalk* this = (EnMhTalk*)thisx;
+
+    Collider_DestroyCylinder(play, &this->collider);
+}
+
+void EnMhTalk_Update(Actor* thisx, PlayState* play) {
+    EnMhTalk* this = (EnMhTalk*)thisx;
+
+    // Slow spin so the beacon reads as an interactive marker (deterministic, no RNG).
+    this->actor.shape.rot.y += 0x0400;
+
+    // Keep the OC collider positioned on the actor and registered each frame so the
+    // player can walk into / target the beacon.
+    Collider_UpdateCylinder(&this->actor, &this->collider);
+    CollisionCheck_SetOC(play, &play->colChkCtx, &this->collider.base);
+
+    if (!this->talkFlag) {
+        if (this->talkTimer == 0) {
+            if (Actor_ProcessTalkRequest(&this->actor, play)) {
+                // Talk accepted; the Player opens this->actor.textId. The debug-console
+                // interpreter handles any resulting item/rupee/branch outcome.
+                this->talkFlag = true;
+            } else {
+                func_8002F2CC(&this->actor, play, 90.0f);
+            }
+        } else {
+            this->talkTimer--;
+        }
+    } else if (Actor_TextboxIsClosing(&this->actor, play)) {
+        this->talkFlag = false;
+        this->talkTimer = 20;
+    }
+}
+
+void EnMhTalk_Draw(Actor* thisx, PlayState* play) {
+    EnMhTalk* this = (EnMhTalk*)thisx;
+
+    OPEN_DISPS(play->state.gfxCtx);
+
+    Gfx_SetupDL_25Opa(play->state.gfxCtx);
+    func_8002EBCC(&this->actor, play, 0);
+    gSPMatrix(POLY_OPA_DISP++, MATRIX_NEWMTX(play->state.gfxCtx), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
+    gSPSegment(POLY_OPA_DISP++, 0x08, SEGMENTED_TO_VIRTUAL(gRupeeGreenTex));
+    gSPDisplayList(POLY_OPA_DISP++, gRupeeDL);
+
+    CLOSE_DISPS(play->state.gfxCtx);
+}
